# VeriAgent environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Funded GenLayer Studio account private key used by deploy/seed scripts.
# 0x-prefixed 32-byte hex. Read only via process.env, never hard-coded.
ACCOUNT_PRIVATE_KEY=0xyour_private_key_here

# Optional. Address that accrues the protocol fee on endorsements.
# Leave blank to default to the deploying account.
FEE_RECIPIENT=

# Optional. Protocol fee in basis points applied to endorsements (100 = 1%).
FEE_BPS=100

# Optional. Overrides the contract address the deploy/seed scripts target.
VERIAGENT_CONTRACT_ADDRESS=

# Optional. Overrides the contract address the frontend reads from.
NEXT_PUBLIC_VERIAGENT_CONTRACT_ADDRESS=
